# NaviAble AI Environment Variables
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# YOLO backend URL — set to your laptop's LAN IP when testing on a physical device.
# Example: EXPO_PUBLIC_YOLO_URL=http://192.168.1.42:8000
# For physical phones, set this to your computer's LAN IP. The 10.0.2.2
# default is reachable from Android Emulator only. Keep .env in this project
# root and restart Metro after changing it.
EXPO_PUBLIC_YOLO_URL=http://10.0.2.2:8000
